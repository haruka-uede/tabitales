# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# content-collections
.content-collections

# staging area for eyecatch images before they're renamed/sorted into
# public/images/{articles,collections} - see .claude/commands/add-eyecatch-image.md
/image-inbox/*
!/image-inbox/.gitkeep

.vercel
.env*

# working notes from ad-hoc review/rewrite passes - not part of the site
/_reviews/
.claude/*.workflow.js
